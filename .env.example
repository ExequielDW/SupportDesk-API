# ==========================================
# SupportDesk API — variables de entorno
# ==========================================
# Copiá este archivo a `.env` y completá los valores.
# NUNCA commitees `.env` (ya está en .gitignore).

# --- Entorno ---
# development: muestra /docs. production: los desactiva y endurece cookies.
ENVIRONMENT=development

# --- MongoDB ---
# MONGODB_FAKE=true levanta la API con un MongoDB EN MEMORIA: no hace falta
# cluster, ni Docker, ni instalar nada. Ideal para probar la app y para la
# demo del repo (los datos se pierden al reiniciar).
# Ponelo en false y completá la URI para usar MongoDB real (Atlas o local).
MONGODB_FAKE=true
# Incluí el nombre de la base en la URI. El usuario de Atlas debe tener
# rol readWrite SOLO sobre esta base.
URI=
DB_NAME=supportdesk
POOL_MAX_SIZE=10
POOL_MIN_SIZE=1

# --- JWT ---
# Generá una con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=supportdesk-api
JWT_AUDIENCE=supportdesk-clients

# --- Redis (opcional) ---
# Si lo dejás vacío o no responde, la app usa un cache EN MEMORIA: todo
# funciona, pero el cache es por proceso (con varios workers cada uno tiene
# el suyo) y los refresh tokens se pierden al reiniciar.
REDIS_URL=

# --- HTTP ---
# Orígenes permitidos para CORS (lista separada por comas). Nunca usar "*".
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1
# true en producción (HTTPS obligatorio, la cookie del refresh lo exige)
COOKIE_SECURE=false
BODY_LIMIT_BYTES=102400
